# Reverse proxy de production — terminaison TLS (Let's Encrypt automatique)
# et routage par sous-domaine vers les services docker-compose.
#
# Variables (fournies par docker-compose.proxy.yml depuis le .env racine) :
#   {$DOMAIN}      domaine racine, ex. natimai.solutions
#   {$ACME_EMAIL}  contact Let's Encrypt (notifications d'expiration)
#
# Prérequis : enregistrements DNS A/AAAA pour le domaine nu, www, api et admin
# pointant vers l'IP publique du serveur ; ports 80 et 443 ouverts.
{
	email {$ACME_EMAIL}
	# Adresse réelle du visiteur ({client_ip}). Par défaut, aucun proxy amont
	# n'est cru : c'est l'adresse du pair TCP. Derrière Cloudflare (nuage
	# orange), CADDY_TRUSTED_PROXIES liste ses plages (DEPLOYMENT.md §9) :
	# CF-Connecting-IP n'est alors lu QUE sur une connexion venant d'elles —
	# quelqu'un qui joint le serveur en direct ne peut pas forger son adresse.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies_strict
	}
}

# En-têtes de sécurité pour les pages servies par les frontends (l'API pose les
# siens elle-même dans main.py).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-Server
	}
}

# Content-Security-Policy (R8 / U4).
#
# Variables du .env racine (docker-compose.proxy.yml) :
#   CSP_HEADER            Content-Security-Policy (défaut, appliquée) ou
#                         Content-Security-Policy-Report-Only pour observer
#                         d'abord les violations dans la console du navigateur.
#   CSP_PAYMENT_SOURCES   origines des prestataires de paiement chargés dans la
#                         page (script du SmartForm PayZen, ses iframes et
#                         appels) ; PayPal passe par une redirection, rien à
#                         autoriser. Défaut : PayZen / Lyra (OSB, Polynésie).
#   CSP_EXTRA_SOURCES     origines supplémentaires (connect/img), ex. l'hôte
#                         d'ingestion Sentry « https://o123.ingest.sentry.io »
#                         ou un bucket S3 public d'images.
#   CSP_REPORT            directive complète de rapport, facultative, ex.
#                         « report-uri https://o123.ingest.sentry.io/api/… ».
#
# Vitrine : le rendu serveur de Quasar insère l'état Pinia dans un <script>
# en ligne, et Vue / Quasar posent des styles en ligne — d'où 'unsafe-inline'
# sur script-src et style-src (pas de nonce possible depuis le proxy). Les
# images produit viennent des fournisseurs, de l'API ou d'un bucket : toute
# origine https.
# challenges.cloudflare.com : le captcha Turnstile des formulaires publics
# (R8 / U5), actif quand le back-office a une clé de site.
(csp_storefront) {
	header {$CSP_HEADER:Content-Security-Policy} "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https:; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com {$CSP_PAYMENT_SOURCES:https://static.osb.pf https://secure.osb.pf https://*.lyra.com https://*.payzen.eu}; style-src 'self' 'unsafe-inline' {$CSP_PAYMENT_SOURCES:https://static.osb.pf https://secure.osb.pf https://*.lyra.com https://*.payzen.eu}; font-src 'self' data: {$CSP_PAYMENT_SOURCES:https://static.osb.pf https://secure.osb.pf https://*.lyra.com https://*.payzen.eu}; img-src 'self' data: blob: https:; connect-src 'self' https://api.{$DOMAIN} https://challenges.cloudflare.com {$CSP_PAYMENT_SOURCES:https://static.osb.pf https://secure.osb.pf https://*.lyra.com https://*.payzen.eu} {$CSP_EXTRA_SOURCES:}; frame-src https://challenges.cloudflare.com {$CSP_PAYMENT_SOURCES:https://static.osb.pf https://secure.osb.pf https://*.lyra.com https://*.payzen.eu}; worker-src 'self' blob:; manifest-src 'self' https://api.{$DOMAIN}; upgrade-insecure-requests; {$CSP_REPORT:}"
}

# Admin : SPA sans rendu serveur, aucun script tiers (Sentry est dans le
# bundle) — script-src strict. Les images de la médiathèque viennent de l'API
# ou d'un bucket.
(csp_admin) {
	header {$CSP_HEADER:Content-Security-Policy} "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.{$DOMAIN} {$CSP_EXTRA_SOURCES:}; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; {$CSP_REPORT:}"
}

# Vitrine (Quasar SSR — Node) sur le domaine nu
{$DOMAIN} {
	import security_headers
	import csp_storefront
	encode zstd gzip
	reverse_proxy frontend:3000
}

# Redirection www → domaine nu
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# API (FastAPI) — corps limité : l'application accepte des uploads de 10 Mo max,
# la limite proxy (16 Mo, marge incluse) évite de recevoir des corps arbitraires
# avant que l'application ne les rejette.
api.{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 16MB
	}
	# Même restriction facultative que admin.{$DOMAIN}, sur les routes
	# d'administration de l'API (ADMIN_ALLOWED_IPS vide = tout le monde).
	@admin_api_denied {
		path /api/v1/admin/*
		not client_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	respond @admin_api_denied "Accès réservé" 403
	# X-Forwarded-For est *remplacé* (et non complété) par l'adresse réelle du
	# visiteur ({client_ip}, cf. bloc global) : le backend (CLIENT_IP_HEADER,
	# posé par docker-compose.proxy.yml) le lit pour le throttle par IP et le
	# journal d'audit, et un client ne peut pas l'allonger pour s'y cacher.
	# `api` tourne en replicas: 2. Un upstream statique `api:8000` ne cible
	# qu'une adresse résolue au démarrage : la seconde réplique ne recevait
	# quasiment rien. `dynamic a` re-résout le DNS Docker et expose les deux
	# conteneurs comme deux upstreams réels.
	#
	# Pas de health_uri actif ici : les répliques partagent la même base, donc
	# /healthz/ready les sortirait TOUTES en même temps et transformerait un 503
	# lisible en 502 opaque. Le health checking passif (fail_duration) suffit à
	# écarter une réplique qui refuse les connexions.
	reverse_proxy {
		dynamic a {
			name api
			port 8000
			refresh 10s
		}
		header_up X-Forwarded-For {client_ip}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 10s
	}
}

# Back-office admin (SPA servie par nginx, écoute sur :80)
#
# Restriction réseau facultative (R6), en plus de la double authentification
# des administrateurs : ADMIN_ALLOWED_IPS = plages autorisées, séparées par des
# espaces (ex. « 203.0.113.0/24 2001:db8::/32 »). Vide = tout le monde (défaut).
# Derrière Cloudflare, renseigner CADDY_TRUSTED_PROXIES (bloc global) pour que
# client_ip soit l'adresse réelle du visiteur et non celle de Cloudflare.
admin.{$DOMAIN} {
	import security_headers
	import csp_admin
	@admin_denied not client_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	respond @admin_denied "Accès réservé" 403
	encode zstd gzip
	reverse_proxy admin-frontend:80
}
