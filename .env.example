# ─────────────────────────────────────────────────────────────────────────────
# Exemple de configuration — copier en `.env` puis renseigner les valeurs.
#   cp .env.example .env
# Le `.env` est ignoré par git (cf. .gitignore). Ne JAMAIS y committer de secret.
# Liste complète des variables : voir README.md et docs/DEPLOYMENT.md
#
# Réglages en base (R5) : beaucoup de variables métier ci-dessous (SHOP_NAME,
# EMAIL_SUPPORT, CGV_VERSION, STOCK_RESERVATION_TTL_HOURS, CART_ABANDONMENT_*,
# INSURANCE_RATE_PCT, INVOICE_LEGAL_FOOTER, PAYMENT_NOTIFICATIONS_*_ENABLED,
# ICECAT_LANGUAGE…) ne sont plus que des VALEURS DE DÉPART : une valeur saisie
# dans Admin → Paramètres l'emporte. Voir docs/DEPLOYMENT.md §3.7.
# ─────────────────────────────────────────────────────────────────────────────

# Domain
# Domaine racine. Sert aussi au reverse proxy Caddy (docker-compose.proxy.yml) :
# routage domaine nu → vitrine, api.<DOMAIN> → API, admin.<DOMAIN> → admin.
# En production : DOMAIN=natimai.solutions
DOMAIN=localhost

# Reverse proxy Caddy — contact Let's Encrypt (requis avec docker-compose.proxy.yml)
ACME_EMAIL=admin@example.com

# CORS — origines autorisées (vitrine, admin, dev quasar)
BACKEND_CORS_ORIGINS=["http://localhost:9000","http://localhost:3000","http://localhost:3001"]
# URL publique de l'admin : la session d'un administrateur ne se renouvelle que
# depuis cette origine (une XSS sur la vitrine ne peut pas l'obtenir). Vide =
# pas de contrôle (avertissement hors local). En production : https://admin.<DOMAIN>
# ADMIN_FRONTEND_HOST=

# URL publique de l'API vue par le NAVIGATEUR, figée dans les frontends au
# `docker compose build` (build-arg Vite). En production : https://api.<DOMAIN>
VITE_API_URL=http://localhost:8000

# Redis : mot de passe (requirepass posé par le compose, envoyé par l'API, les
# workers et le poller). Vide = sans mot de passe (réseau interne seulement) ;
# recommandé en production.
# REDIS_PASSWORD=

# Webhook sortant (rappels des départs) : hôtes autorisés, séparés par des
# virgules. Défaut : Make, Zapier, Slack, IFTTT, Discord. Tout autre hôte est refusé.
# OUTBOUND_WEBHOOK_ALLOWED_HOSTS=hooks.zapier.com,hook.eu1.make.com

# Environnement : local, staging, production
ENVIRONMENT=local

# Alerte opérationnelle (recommandé en production) — webhook façon Slack
# (`{"text": …}`, compatible Mattermost ; Discord : suffixer l'URL par /slack).
# Notifie : outbox dégradé/rétabli, job ARQ abandonné après 5 tentatives.
# Vide = log uniquement.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Routage des emails (requis pour éviter un 503 sur /cart/guest-quote-request)
EMAIL_SUPPORT=contact@example.com
EMAIL_CONTACT=contact@example.com
# Fournisseur d'envoi des notifications de paiement : mailgun | noop
PAYMENT_NOTIFICATIONS_EMAIL_PROVIDER=mailgun
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3
MAILGUN_DOMAIN=example.com
MAILGUN_API_KEY=changeme-your-mailgun-api-key
MAILGUN_FROM_EMAIL=contact@example.com

# Base de données — lues à la fois par le conteneur postgres (création du rôle
# et de la base) et par l'API / le worker / le poller / le health-checker.
# Les valeurs ci-dessous sont les DÉFAUTS de docker-compose.yml : elles laissent
# un `docker compose up` fonctionner sans .env, mais `postgres` comme mot de
# passe fait échouer le démarrage hors ENVIRONMENT=local (warning en local).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-strong-database-password
POSTGRES_DB=fastapi_ecommerce

# Stock — durée de vie d'une réservation prise au checkout, en heures.
# Le stock est décrémenté à la création de la commande ; sans ce balayage, un
# panier abandonné sur la page de paiement le retenait indéfiniment. Seules les
# commandes restées en statut « Pending » sont libérées : un virement en cours
# de validation (AwaitingPayment) n'est jamais touché. 0 désactive le balayage.
STOCK_RESERVATION_TTL_HOURS=48

# Delisting — délai de grâce avant de désactiver une référence que le
# fournisseur ne renvoie plus, en heures. La première absence est seulement
# enregistrée (une panne passagère ne doit pas vider le catalogue) ; la
# désactivation n'intervient que si l'absence dure. 0 = ne jamais désactiver.
SUPPLIER_DELISTING_GRACE_HOURS=72

# Stockage des fichiers (pièces de paiement, imports, images). En production :
# s3 obligatoire (le démarrage échoue sur local) sauf FILE_STORAGE_ALLOW_LOCAL=true
# pour un volume local assumé — et sauvegardé avec la base.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_ALLOW_LOCAL=false
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_KEY_ID=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1

# Import de catalogue fichier (CSV / Excel). Jusqu'à cette taille l'import
# tourne dans la requête ; au-delà le fichier est déposé dans le stockage
# (FILE_STORAGE_BACKEND) et importé par le worker ARQ, l'admin suit le journal.
# Images publiques (accueil, produits, catégories) téléversées depuis l'admin,
# ré-encodées en WebP et servies par GET /api/v1/media/… En production :
# l'origine publique de l'API (https://api.exemple.pf). Vide en développement.
MEDIA_PUBLIC_BASE_URL=
# Taille maximale d'une image envoyée (8 Mo par défaut).
# MEDIA_MAX_UPLOAD_BYTES=8388608

# Territoire et mode de la boutique. TERRITORY_PROFILE=PF (Polynésie : XPF, TVA,
# corridor France → Papeete, arbre des îles) ou FR (métropole : EUR, TVA).
# SHOP_MODE=simple pour une boutique à un entrepôt qui vend son propre stock
# et expédie directement (fournisseurs, douane, logistique multi-tronçons masqués).
TERRITORY_PROFILE=PF
SHOP_MODE=full

# Langues (R7) : déduites du profil (fr par défaut, fr et en proposés, fuseau
# Pacific/Tahiti en PF, Europe/Paris en FR). À fixer seulement pour s'en écarter.
# SHOP_DEFAULT_LOCALE=fr
# SHOP_LOCALES=fr,en
# SHOP_TIMEZONE=Pacific/Tahiti

# Relance des paniers abandonnés : délai sans activité avant le rappel
# (0 = désactivé) et âge maximal d'un panier encore relancé.
CART_ABANDONMENT_REMINDER_DELAY_HOURS=24
CART_ABANDONMENT_MAX_AGE_DAYS=14

SUPPLIER_FILE_IMPORT_INLINE_MAX_ROWS=2000
SUPPLIER_FILE_IMPORT_MAX_ROWS=250000

# Disponibilité fournisseur — re-vérification synchrone au checkout.
# product.supplier_quantity est un instantané rafraîchi toutes les 2 h ; sans
# ce contrôle, la commande est prise sur une donnée périmée (risque d'oversell
# structurel en drop-ship). Un appel par commande, sur les lignes fournisseur
# uniquement. Une panne du fournisseur ne bloque JAMAIS la vente : l'instantané
# fait alors foi. Le délai est court, on est sur le chemin critique du paiement.
CHECKOUT_SUPPLIER_AVAILABILITY_CHECK=true
CHECKOUT_SUPPLIER_CHECK_TIMEOUT_SECONDS=8

# Security — générer une clé aléatoire, ex: `openssl rand -base64 32`
# OBLIGATOIRE : une valeur vide fait échouer le démarrage hors ENVIRONMENT=local
# (en local, une clé aléatoire est tirée avec un warning — les tokens ne
# survivent alors pas à un redémarrage).
SECRET_KEY=changeme-generate-a-secure-random-key

# Compte admin initial (créé par initial_data). OBLIGATOIRE : laisser les valeurs
# placeholder fait échouer le démarrage hors ENVIRONMENT=local (warning en local).
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme-strong-admin-password

# Auth — le refresh token est servi en cookie HttpOnly (l'access token reste en
# mémoire du SPA). Les défauts conviennent au schéma par sous-domaines
# (vitrine/admin → api.) : cookie host-only sur l'API, SameSite=Lax, Secure
# automatique (off en local http, on hors local). À surcharger seulement pour un
# cas particulier (ex. cookie partagé entre sous-domaines).
# REFRESH_COOKIE_SAMESITE=lax        # lax | strict | none (none impose Secure)
# REFRESH_COOKIE_DOMAIN=             # vide = host-only (recommandé)
# REFRESH_COOKIE_SECURE=             # vide = auto (true hors ENVIRONMENT=local)

# Alerting (I8) — webhook appelé quand quelque chose casse silencieusement :
# event outbox définitivement perdu après 5 tentatives, health-check en erreur,
# sauvegarde échouée. Sans lui ces incidents ne vivent que dans les logs, que
# personne ne lit avant qu'un client ne se plaigne.
# Accepte une URL entrante Slack/Mattermost/Discord, ou tout endpoint JSON.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# ALERT_THROTTLE_SECONDS=900        # anti-spam : même incident, 1 alerte / 15 min
# ALERT_ENVIRONMENT_LABEL=          # vide = valeur d'ENVIRONMENT

# Facturation (M3) — AMORÇAGE de l'identité du vendeur.
# L'identité légale vit en base (system_settings, clés legal_*), éditable depuis
# le back-office et partagée avec les pages légales de la vitrine : ce dépôt est
# un modèle, l'état civil d'une société est de la donnée de déploiement.
# Ces variables ne servent qu'à donner une valeur INITIALE à la création des
# clés ; elles n'écrasent jamais une valeur déjà saisie. Voir docs/DEPLOYMENT.md §13.
# INVOICE_ISSUER_NAME=
# INVOICE_ISSUER_LEGAL_FORM=          # ex. SARL au capital de X XPF
# INVOICE_ISSUER_ADDRESS=
# INVOICE_ISSUER_REGISTRATION_NUMBER= # numéro TAHITI / RC
# INVOICE_ISSUER_TAX_ID=
# INVOICE_ISSUER_EMAIL=
# INVOICE_ISSUER_PHONE=
# INVOICE_PAYMENT_TERMS=
# INVOICE_LATE_PENALTY_TERMS=

# Prix de revient — assurance fret (F4). Taux de la police ad valorem, appliqué
# à l'assiette CAF (coût + fret d'import variable) avant les droits de douane.
# 0 = aucune assurance dans le prix : si une police est souscrite sans saisir
# son taux ici, la prime est payée et jamais récupérée sur les ventes.
# INSURANCE_RATE_PCT=0.0

# Durcissement login — throttle par IP (Redis) + verrouillage de compte.
# Adresse réelle du client : avec docker-compose.proxy.yml, l'API lit
# X-Forwarded-For réécrit par Caddy (CLIENT_IP_HEADER posé par le compose).
# À fixer soi-même seulement pour un autre montage de proxy ; vide si l'API
# est exposée en direct (un en-tête forgé contournerait le throttle par IP).
# CLIENT_IP_HEADER=X-Forwarded-For
# Derrière Cloudflare (nuage orange) : ses plages, pour que Caddy lise
# CF-Connecting-IP sur leurs connexions seulement (liste : docs/DEPLOYMENT.md §9,
# https://www.cloudflare.com/ips/).
# CADDY_TRUSTED_PROXIES="173.245.48.0/20 103.21.244.0/22 … 2c0f:f248::/32"
# LOGIN_RATE_LIMIT_ATTEMPTS=10       # tentatives par IP par fenêtre
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_LOCKOUT_MAX_FAILURES=5       # échecs depuis une même adresse avant qu'elle soit bloquée sur ce compte
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_ACCOUNT_LOCKOUT_MAX_FAILURES=50  # échecs consécutifs, toutes adresses, avant verrouillage du compte
# Double authentification des administrateurs : vide = obligatoire en
# production (SECRETS_ENCRYPTION_KEY alors exigée), facultative ailleurs.
# ADMIN_2FA_REQUIRED=
# Conservation du journal d'audit des administrateurs, en jours (0 = toujours).
# AUDIT_LOG_RETENTION_DAYS=400
# Plages IP autorisées pour l'administration (séparées par des espaces) ;
# vide = tout le monde. Caddy filtre admin.<DOMAIN> et /api/v1/admin/* ; l'API
# applique la même liste à toute requête d'un superuser, quelle que soit la route.
# ADMIN_ALLOWED_IPS=

# Facturation (M3) — identité du vendeur imprimée sur les factures PDF.
# AMORÇAGE SEULEMENT : copiées une fois dans Admin → Paramètres → Identité
# légale au premier démarrage ; c'est ensuite l'écran qui fait foi.
# OBLIGATOIRE avant d'émettre une facture réelle : une facture sans
# identification complète du vendeur n'est pas conforme. L'émission loggue un
# warning tant que l'adresse et l'immatriculation sont vides.
INVOICE_SELLER_NAME=Natimai Solutions
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_REGISTRATION=       # RC Papeete + n° TAHITI
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
INVOICE_LEGAL_FOOTER=              # mentions de pied de facture
# Code du taux appliqué aux frais (livraison, paiement) dans la ventilation de
# taxe, et du taux par défaut des articles : points de départ seulement, les deux
# se choisissent ensuite dans l'admin (Taux de TVA → Taux appliqués), comme les
# taux eux-mêmes. ⚠️ À faire confirmer par le comptable.
# DEFAULT_TAX_CODE=TVA_NORMALE
# INVOICE_FEES_TAX_CODE=TVA_NORMALE

# Antivirus ClamAV — scan des documents uploadés (bons de commande, justificatifs).
# OBLIGATOIRE hors ENVIRONMENT=local : false → NoOpScanner (tout est déclaré sain)
# et le backend refuse de démarrer (warning seulement en local). Les services du
# compose (api, arq-worker, outbox-poller, outbox-health-checker, migrate) le
# forcent à true ; à renseigner ici pour un run hors Docker.
CLAMAV_ENABLED=true
# CLAMAV_HOST=clamav   # localhost si ClamAV tourne via docker compose et l'API sur l'hôte
# CLAMAV_PORT=3310

# Paiement CB — PayZen / Lyra (les valeurs *_TEST ou *_PROD sont choisies selon PAYZEN_MODE)
PAYZEN_MODE=TEST  # TEST | PRODUCTION
PAYZEN_SITE_ID=changeme-payzen-site-id
PAYZEN_API_PASSWORD_TEST=changeme-payzen-rest-password-test
PAYZEN_PUBLIC_KEY_TEST=changeme-payzen-public-key-test
# Capture différée : true → CB autorisée au checkout (statut Authorized), débit à la
# capture (ex. à l'expédition via POST /admin/payments/{id}/capture). Empreinte ~7 j.
PAYZEN_MANUAL_VALIDATION=false
# Remboursement CB depuis l'admin par l'API PayZen (CancelOrRefund). false → le
# remboursement est enregistré « en attente », à finaliser dans le back-office PayZen.
PAYZEN_API_REFUND_ENABLED=false

# PayPal (Orders API v2) — activé depuis l'admin (Paiements → Prestataires) une fois
# ces identifiants renseignés. Les commandes XPF sont débitées en EUR (1 000 XPF = 8,38 EUR).
# Webhook à déclarer chez PayPal : https://<api>/api/v1/payments/webhooks/paypal
# (événements PAYMENT.CAPTURE.* et PAYMENT.AUTHORIZATION.*), puis reporter son id ici.
PAYPAL_MODE=sandbox  # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=EUR
# PAYPAL_INTENT=CAPTURE  # AUTHORIZE → débit à la capture depuis l'admin (comme PAYZEN_MANUAL_VALIDATION)

# Commande fournisseur automatique (créée à la capture du paiement)
INGRAM_ORDER_CREATION_ENABLED=false

# Ingram Micro API — seuls les identifiants restent ici. Le reste du fournisseur
# (entrepôt d'origine, régime douanier, catégories, cadence, environnement) vit
# dans la table `suppliers`, éditable depuis Admin → Fournisseurs.
# Vides = Ingram non configuré (aucun appel). Une valeur « changeme-… » compte
# aussi comme vide.
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
INGRAM_CUSTOMER_NUMBER=
# Valeurs d'amorçage de la ligne `ingram_micro` (premier démarrage) et repli
# quand la ligne ne précise rien ; INGRAM_SYNC_ENABLED reste un coupe-circuit
# global au-dessus du réglage par fournisseur.
INGRAM_COUNTRY_CODE=FR
INGRAM_ENVIRONMENT=sandbox  # ou "production"
INGRAM_SYNC_ENABLED=true
INGRAM_SYNC_INTERVAL_HOURS=6  # amorçage seulement : la ligne fournisseur fait foi ensuite
INGRAM_SYNC_CATEGORIES=["Ordinateur/Serveur"]

# Clé Fernet qui chiffre les secrets stockés en base : identifiants de portail
# des fournisseurs par lien (Foxway, Picata…) et secrets de double
# authentification des administrateurs. Sans elle, ni l'un ni l'autre ne peut
# être enregistré (OBLIGATOIRE en production : la 2FA admin y est exigée). Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : « nouvelle,ancienne » (la première chiffre, les autres relisent).
SECRETS_ENCRYPTION_KEY=
SUPPLIER_FEED_MAX_BYTES=26214400
SUPPLIER_FEED_TIMEOUT_SECONDS=60

SUPPLIER_SYNC_MIN_QUANTITY=10
SUPPLIER_SYNC_MIN_PRICE=10

# Icecat API
# Vides = Icecat non configuré. ICECAT_ENABLED est un coupe-circuit global :
# en dessous, l'interrupteur « Enrichissement Icecat » (Admin → Modules)
# l'allume ou l'éteint sans redémarrage (éteint par défaut en SHOP_MODE=simple).
ICECAT_USERNAME=
ICECAT_API_KEY=
ICECAT_LANGUAGE=fr
ICECAT_ENABLED=true

# --- Observabilité (R8 / U3) -------------------------------------------------
# Journaux : json (défaut hors local) ou text ; niveau racine.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Jeton exigé par GET /metrics (Prometheus) hors local ; vide = route absente.
# METRICS_TOKEN=
# Sentry des navigateurs (figé dans les images des fronts au build).
# VITE_SENTRY_DSN=
