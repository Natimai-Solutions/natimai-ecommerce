{
  "name": "frontend",
  "version": "0.0.1",
  "description": "A ecommerce frontend for fastapi-ecommerce API",
  "license": "AGPL-3.0-or-later",
  "productName": "Ecommerce Frontend",
  "author": "Natimai Solutions",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build -m ssr",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@app/api-client": "workspace:*",
    "@app/api-types": "workspace:*",
    "@app/ui": "workspace:*",
    "@app/utils": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@quasar/extras": "^2.1.0",
    "@sentry/vue": "^11.8.0",
    "dompurify": "^3.4.17",
    "isomorphic-dompurify": "^3.23.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.6",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.20.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
