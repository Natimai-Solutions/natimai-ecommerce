{
  "name": "admin",
  "version": "0.0.1",
  "description": "Admin frontend for FastAPI ecommerce",
  "license": "AGPL-3.0-or-later",
  "productName": "Admin Frontend",
  "author": "Natimai Solutions",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build -m spa",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@app/api-client": "workspace:*",
    "@app/api-types": "workspace:*",
    "@app/utils": "workspace:*",
    "@quasar/extras": "^1.18.0",
    "pinia": "^3.0.4",
    "quasar": "^2.27.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@quasar/app-vite": "^2.6.2",
    "@types/node": "^22.20.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
