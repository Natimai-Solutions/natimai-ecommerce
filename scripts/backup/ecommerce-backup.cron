# Sauvegarde quotidienne — à installer sur le serveur de production :
#   sudo cp scripts/backup/ecommerce-backup.cron /etc/cron.d/ecommerce-backup
#   sudo chown root:root /etc/cron.d/ecommerce-backup && sudo chmod 644 /etc/cron.d/ecommerce-backup
#
# Adapter APP_DIR, l'utilisateur (doit être dans le groupe docker) et surtout
# BACKUP_REMOTE : sans copie hors serveur, la sauvegarde disparaît avec le
# serveur qu'elle est censée protéger.
#
# Vérifier ensuite que la restauration fonctionne VRAIMENT :
#   ./scripts/backup/restore.sh backups/db_<STAMP>.dump
# (mode répétition à blanc par défaut : conteneur jetable, aucun risque).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Copie hors serveur (rclone configuré au préalable pour l'utilisateur du cron).
BACKUP_REMOTE=remote:ecommerce-backups
BACKUP_REMOTE_CMD=rclone
# Webhook d'alerting — même valeur que ALERT_WEBHOOK_URL dans le .env racine.
ALERT_WEBHOOK_URL=

# m  h  dom mon dow  user      command
  0  2  *   *   *    deploy    cd /opt/fastapi-ecommerce && ./scripts/backup/backup.sh >> /var/log/ecommerce-backup.log 2>&1
