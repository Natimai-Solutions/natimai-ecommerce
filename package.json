{
  "name": "natimai-ecommerce",
  "description": "E-commerce platform: FastAPI API, Quasar storefront (SSR) and back-office, shared TypeScript packages",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Natimai-Solutions/natimai-ecommerce.git"
  },
  "homepage": "https://github.com/Natimai-Solutions/natimai-ecommerce#readme",
  "bugs": "https://github.com/Natimai-Solutions/natimai-ecommerce/issues",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "gen:types": "./scripts/gen-api-types.sh",
    "dev:front": "pnpm --filter frontend dev",
    "dev:admin": "pnpm --filter admin dev",
    "build:front": "pnpm --filter frontend build",
    "build:admin": "pnpm --filter admin build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "./scripts/gen-api-types.sh --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "undici@<8.10.2": ">=8.10.2",
      "qs@<6.16.0": ">=6.16.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@<4.3.2": "~4.3.2",
      "proxy-addr@<2.0.8": ">=2.0.8",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  }
}
